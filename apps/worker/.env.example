OPENAI_API_KEY=
# Worker dev will auto-load apps/worker/.env.local first, then root .env.local.
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Redis
# Production must use authenticated TLS, e.g. rediss://user:password@host:port.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Worker runtime
AI_WORKER_CONCURRENCY=2
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=10000
# Provider request deadline. Review it together with the deployment drain time.
OPENAI_IMAGE_REQUEST_TIMEOUT_MS=240000
AI_JOB_LOCK_DURATION_MS=60000
AI_JOB_STALLED_INTERVAL_MS=30000
AI_JOB_MAX_STALLED_COUNT=1
AI_JOB_STALLED_AFTER_MS=1800000
AI_JOB_RECONCILIATION_INTERVAL_MS=300000
AI_JOB_RECONCILIATION_BATCH_SIZE=25
AI_JOB_QUEUE_WAIT_ALERT_MS=120000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Railway healthcheck: /healthz for liveness, /readyz for Redis + Supabase.
WORKER_HEALTH_PORT=8080
# Staging-only: allows deterministic image-job simulations without OpenAI cost.
# Keep false or unset in production.
CARVER_ENABLE_AI_JOB_SIMULATION=false

# Optional generic JSON alert webhook. Production must use HTTPS.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_MS=300000

# R2 library metadata sync
LIBRARY_R2_SYNC_ENABLED=true
LIBRARY_SYNC_INTERVAL_MS=1800000

# Removes only stale, unreferenced objects under Carver-managed R2 prefixes.
# Use dry-run first in staging to inspect worker logs before enabling deletion.
# Manual run: npm run r2:orphan-cleanup --workspace @carver/worker
R2_ORPHAN_CLEANUP_ENABLED=true
R2_ORPHAN_CLEANUP_INTERVAL_MS=21600000
R2_ORPHAN_CLEANUP_TTL_MS=604800000
R2_ORPHAN_CLEANUP_DRY_RUN=false
