# Supabase client side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret keys for web server / API routes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Staging-only: permits deterministic queued image-job simulations without OpenAI cost.
# Keep false or unset in production.
CARVER_ENABLE_AI_JOB_SIMULATION=false
ASSET_GATEWAY_SIGNING_SECRET=
# Comma-separated web origins permitted to read private images from the gateway.
CARVER_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated Supabase Auth user IDs allowed to view /field-notes diagnostics.
CARVER_INTERNAL_ADMIN_USER_IDS=

# Queue clients must use authenticated TLS Redis in production.
REDIS_URL=

# Optional generic JSON alert webhook for server and worker failure events.
# Production URLs must use HTTPS. The payload contains only redacted metadata.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_MS=300000

# Cloudflare R2 private bucket
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Public landing assets must use a separate bucket/domain from user-owned assets.
CLOUDFLARE_LANDING_R2_BUCKET=
CLOUDFLARE_LANDING_PUBLIC_BASE_URL=
NEXT_PUBLIC_LANDING_ASSET_BASE_URL=
