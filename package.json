{
  "name": "carver-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storage:landing:dry-run": "node scripts/upload-landing-assets.mjs --dry-run",
    "storage:landing:upload": "node scripts/upload-landing-assets.mjs",
    "storage:orphan-r2:dry-run": "node scripts/orphan-r2-cleanup.mjs",
    "storage:orphan-r2:delete": "node scripts/orphan-r2-cleanup.mjs --delete",
    "security:env": "node scripts/verify-security-env.mjs"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "overrides": {
    "eslint": "9.39.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
