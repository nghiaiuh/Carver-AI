{
  "name": "carver-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storage:landing:dry-run": "node scripts/upload-landing-assets.mjs --dry-run",
    "storage:landing:upload": "node scripts/upload-landing-assets.mjs",
    "storage:orphan-r2:dry-run": "node scripts/orphan-r2-cleanup.mjs",
    "storage:orphan-r2:delete": "node scripts/orphan-r2-cleanup.mjs --delete",
    "storage:temp-assets:dry-run": "node scripts/temp-asset-cleanup.mjs",
    "storage:temp-assets:delete": "node scripts/temp-asset-cleanup.mjs --delete",
    "security:env": "node scripts/verify-security-env.mjs",
    "security:api-boundaries": "node scripts/verify-api-error-boundaries.mjs",
    "test:prompt-engine": "node scripts/run-prompt-engine-tests.mjs",
    "migration:validate": "node scripts/validate-sql-migrations.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "10.9.1",
    "supabase": "^2.109.1",
    "turbo": "latest"
  },
  "overrides": {
    "eslint": "10.9.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
