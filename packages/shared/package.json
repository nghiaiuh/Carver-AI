{
  "name": "@carver/shared",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "module": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing/openaiTransport": {
      "types": "./src/testing/openaiTransport.ts",
      "import": "./dist/testing/openaiTransport.js",
      "require": "./dist/testing/openaiTransport.js",
      "default": "./dist/testing/openaiTransport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w",
    "test": "tsx --test src/security-contracts.test.ts src/canvas-draft.test.ts src/image-generator.test.ts src/assistant-output.test.ts src/camera-normalization.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
