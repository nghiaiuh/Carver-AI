{
  "name": "@carver/storage",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "module": "./src/r2.ts",
      "default": "./dist/r2.js"
    },
    "./image-data": {
      "types": "./dist/imageData.d.ts",
      "module": "./src/imageData.ts",
      "default": "./dist/imageData.js"
    },
    "./image-format": {
      "types": "./src/imageFormat.ts",
      "module": "./src/imageFormat.ts",
      "default": "./src/imageFormat.ts"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "module": "./src/library.ts",
      "default": "./dist/library.js"
    },
    "./library-metadata": {
      "types": "./src/libraryMetadata.ts",
      "module": "./src/libraryMetadata.ts",
      "default": "./src/libraryMetadata.ts"
    },
    "./library-sync": {
      "types": "./dist/librarySync.d.ts",
      "module": "./src/librarySync.ts",
      "default": "./dist/librarySync.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@carver/db": "*",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.9.3"
  }
}
