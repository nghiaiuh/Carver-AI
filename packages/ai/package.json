{
  "name": "@carver/ai",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prompt-engine": {
      "types": "./src/prompt-engine/index.ts",
      "import": "./dist/prompt-engine/index.js",
      "require": "./dist/prompt-engine/index.js",
      "default": "./dist/prompt-engine/index.js"
    },
    "./prompt-engine/server": {
      "types": "./src/prompt-engine/server.ts",
      "import": "./dist/prompt-engine/server.js",
      "require": "./dist/prompt-engine/server.js",
      "default": "./dist/prompt-engine/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:prompt-engine": "node ../../scripts/run-prompt-engine-tests.mjs"
  },
  "dependencies": {
    "@carver/shared": "*",
    "@langchain/langgraph": "^1.4.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.4.5"
  }
}
