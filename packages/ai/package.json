{
  "name": "@carver/ai",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prompt-engine": {
      "types": "./dist/prompt-engine/index.d.ts",
      "import": "./dist/prompt-engine/index.js",
      "require": "./dist/prompt-engine/index.js",
      "default": "./dist/prompt-engine/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@carver/shared": "*",
    "@langchain/langgraph": "latest"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
